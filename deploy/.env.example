# Copy to .env and fill in. Never commit .env.

# Public domain served by Caddy (DNS A record must point at this host).
# docker-compose derives PUBLIC_URL=https://$DOMAIN from it.
DOMAIN=www.petanque21st.com

# Data directory inside the container (SQLite db + uploads). Leave as is with the compose volume.
DATA_DIR=/data

# Listen address inside the container.
ADDR=:8080

# First-start admin account. ADMIN_PASSWORD must be >= 12 characters and is
# only used when no admin exists yet (changing it later has no effect). To
# change or recover the password afterwards use the CLI (see README "Recovery"):
#   docker compose exec -it app /server admin reset-password admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Session signing secret, >= 32 bytes:  openssl rand -base64 48
SESSION_SECRET=

# TOTP secret encryption key, exactly 32 bytes base64-encoded:  openssl rand -base64 32
# Back this file up: without the same key the stored TOTP secrets cannot be decrypted.
TOTP_ENC_KEY=

# Optional GitHub OAuth App for linking an account (set BOTH or NEITHER).
# Callback URL: https://$DOMAIN/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Send the session cookie as Secure. Only set to false for plain-http local testing.
COOKIE_SECURE=true

# Proxy network allowed to set X-Forwarded-For. Must match the subnet of the
# compose "internal" network (172.28.0.0/16 in docker-compose.yml). If unset the
# server trusts no proxy and every request would appear to come from Caddy.
TRUSTED_PROXY_CIDR=172.28.0.0/16
